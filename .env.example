# Copy to .env.local and fill private values.
BASE_URL=https://example.com/v1
API_KEY=replace-with-your-key
MODEL_NAME=Qwen3.5-397B-A17B
# Optional: model id sent to the API. If empty, MODEL_NAME is used.
MODEL_API_NAME=

# Optional per-stage API model overrides. Empty values use MODEL_API_NAME.
PLANNING_MODEL_API_NAME=
EVIDENCE_MODEL_API_NAME=
CONTROLLER_MODEL_API_NAME=
VLM_MODEL_API_NAME=

# Optional OpenAI-compatible provider controls. Leave THINKING empty when the
# provider does not implement it. MiMo structured stages use disabled thinking
# and max_completion_tokens.
MYCODE_LLM_THINKING=
MYCODE_LLM_TOKEN_FIELD=max_tokens
MYCODE_LLM_MIN_COMPLETION_TOKENS=0
MYCODE_LLM_RETRIES=4
MYCODE_LLM_RETRY_DELAYS=5,15,30,60

# Image payload mode for VLM calls: data_uri, url, or auto.
MYCODE_VLM_IMAGE_TRANSPORT=data_uri

# Standalone repository assets. Existing LocAgent/MM-IR/etc. structures are
# reused first; only missing assets are downloaded and cached here.
MYCODE_AUTO_FETCH_REPOS=1
MYCODE_REPO_CACHE_DIR=.mycode_cache
MYCODE_REPO_REMOTE_TEMPLATE=https://github.com/{repo}.git
# Optional existing checkout or checkout parent. The checkout must match the
# sample's base_commit before it is used.
MYCODE_REPO_ROOT=
