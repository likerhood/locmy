# Reproducible runtime switches. Keep provider credentials in a separate .env file.
# The launch scripts automatically prefer <repository>/.venv/bin/python.
FULL_MM=1
ALLOW_NETWORK=1
ALLOW_BROWSER=1
DOWNLOAD_IMAGES=1
USE_VLM=1
MYCODE_VLM_IMAGE_TRANSPORT=auto
MYCODE_RUNTIME_PREFLIGHT=1
MYCODE_BROWSER_REQUIRED=1
MYCODE_AUTO_FETCH_REPOS=1
MYCODE_REQUIRE_SOURCE_CHECKOUT=1
MYCODE_REPO_CACHE_DIR=.mycode_cache

# Search defaults use bounded seeds, evidence locks and a tail-preserving head selector.
MYCODE_FAST_SEED_PLANNER=1
MYCODE_FAST_SEED_LLM=1
MYCODE_FAST_SEED_CANDIDATES=10
MYCODE_FAST_SEED_SHORTLIST=6
MYCODE_FAST_SEED_LIMIT=3
MYCODE_LLM_REVIEW_CANDIDATES=6
MYCODE_CANDIDATE_REVIEW_MAX_TOKENS=1200
MYCODE_REACT_ENFORCE_TOOL_COVERAGE=0
MYCODE_REACT_NO_GAIN_STEPS=2
MYCODE_CROSS_ROUND_LOCKED_HEAD=2
MYCODE_CROSS_ROUND_MAX_REPLACEMENTS=4
MYCODE_CROSS_ROUND_PROTECTED_PREFIX=0
MYCODE_FINAL_SEED_PREFIX=2
MYCODE_HEAD_REPLACEMENT_MARGIN=3.0
MYCODE_HEAD_REQUIRE_RESPONSIBILITY=1
MYCODE_SEED_RESPONSIBILITY_GUARD=1
MYCODE_MEMORY_ROUND_DECAY=0.90
MYCODE_MEMORY_NO_GAIN_DECAY=0.75
MYCODE_FLOW_MODE=auto
MYCODE_DEEP_FLOW_AUTO=1
MYCODE_DEEP_FLOW_CANDIDATE_LIMIT=32
MYCODE_INTERPROCEDURAL_MAX_HOPS=2
MYCODE_EARLY_STOP_EVIDENCE_PLATEAU=1
MYCODE_EVIDENCE_PLATEAU_ROUNDS=2
MYCODE_PLATEAU_REVIEW_OVERRIDE_ROUND=6
