# Copy to .env.local. Dedicated repair credentials; never commit this file's filled copy.
RQ4_BASE_URL=
RQ4_API_KEY=
RQ4_MODEL=Qwen3.5-397B-A17B
RQ4_REQUEST_TIMEOUT=900
# Retry only explicit transient HTTP responses (429/500/502/503/504).
# Uncertain transport failures are not resent as the same candidate; later candidates continue.
RQ4_HTTP_RETRIES=2
RQ4_HTTP_RETRY_SLEEPS=10,30
# Set to 1 only when this API host should bypass inherited HTTP(S) proxies.
# The code adds only RQ4_BASE_URL's hostname to NO_PROXY/no_proxy.
RQ4_API_DIRECT=0
# Exact base_commit repositories can be discovered from mycode's existing cache.
# Set only if a custom cache location was used previously:
MYCODE_REPO_CACHE_DIR=

# Direct GitHub is the default: disable mirrors and add GitHub hosts to
# NO_PROXY/no_proxy for this process and all pipeline child processes.
RQ4_GITHUB_DIRECT=1
# Used only when RQ4_GITHUB_DIRECT=0. Empty disables the mirror.
RQ4_GITHUB_MIRROR_PREFIX=
RQ4_GIT_TIMEOUT=600
RQ4_GIT_RETRIES=2
RQ4_MIN_FREE_GB=10
# budget: retain images until space is needed; sample: remove owned image after all methods.
RQ4_IMAGE_CACHE=budget
RQ4_IMAGE_PULL_TIMEOUT=1800
# Total pull attempts. Docker keeps completed layers between attempts.
RQ4_IMAGE_PULL_RETRIES=3
RQ4_IMAGE_PULL_RETRY_DELAY=10

# Optional: only after your independent Docker daemon has been installed and verified.
# Use the actual UID; env files do not execute $(id -u).
# DOCKER_HOST=unix:///run/user/1000/docker.sock
# Unset DOCKER_CONTEXT in the launching shell; CLI and SDK must use the same socket.
# Only for a detected containerd snapshotter: its verified actual data directory.
# RQ4_CONTAINERD_DATA_ROOT=/data2/your-confirmed-containerd-directory
